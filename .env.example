# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file matching *.env (see .gitignore).

# Google Tag Manager container ID (public, exposed to the browser)
# Used in: src/lib/analytics/config.ts, src/components/analytics/GoogleTagManager.tsx
NEXT_PUBLIC_GTM_ID=

# Facebook Pixel ID (public, exposed to the browser)
# Used in: src/lib/analytics/config.ts, src/components/analytics/FacebookPixel.tsx
NEXT_PUBLIC_FB_PIXEL_ID=

# Cloudflare Turnstile site key (public, exposed to the browser)
# Used in: src/lib/analytics/config.ts, src/components/turnstile/CloudflareTurnstile.tsx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (server-side only, keep private)
# Used in: src/lib/analytics/turnstileVerify.ts
TURNSTILE_SECRET_KEY=

# Supabase — used by `npm run db:push` to apply migrations
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
