# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file matching *.env (see .gitignore).

# Google Tag Manager container ID (public, exposed to the browser)
# Used in: src/lib/analytics/config.ts, src/components/analytics/GoogleTagManager.tsx
NEXT_PUBLIC_GTM_ID=

# Facebook Pixel ID (public, exposed to the browser)
# Used in: src/lib/analytics/config.ts, src/components/analytics/FacebookPixel.tsx
NEXT_PUBLIC_FB_PIXEL_ID=

# Cloudflare Turnstile site key (public, exposed to the browser)
# Used in: src/lib/analytics/config.ts, src/components/turnstile/CloudflareTurnstile.tsx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (server-side only, keep private)
# Used in: src/lib/analytics/turnstileVerify.ts
TURNSTILE_SECRET_KEY=

# Supabase CLI auth — used by `npm run db:push` and the `supabase:*` scripts
# only (not read by application code).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=

# Supabase project URL/anon key — used by the admin UI's Auth clients
# (src/lib/supabase/*) and as the apikey/Authorization on Edge Function calls
# (src/lib/supabase/admin-api.ts). Public by design, not the access-control
# secret. Find these in Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sent as the x-admin-secret header on knowledge list/create/update/delete
# calls (src/lib/supabase/admin-api.ts). Server-only — never exposed to the
# browser. Must be set to the SAME value already configured in
# supabase/functions/.env(.production) — these are two separate deployables
# (this Next.js app vs. the Edge Functions) sharing one secret, not two
# different secrets. Don't forget to update both when rotating it.
INGEST_ADMIN_SECRET=

# Edge Function secrets (Cloudflare AI Gateway, etc.) live in
# supabase/functions/.env(.production) — copy supabase/functions/.env.example
# and fill it in. SUPABASE_URL / SERVICE_ROLE_KEY / ANON_KEY are injected
# automatically by the Supabase CLI/runtime and must not be set there.
