# Workers AI v1 (OpenAI-compatible) API — https://api.cloudflare.com/client/v4/accounts/{id}/ai/v1/*
CF_ACCOUNT_ID=
# Cloudflare API token scoped to Account > Workers AI > Read (Edit if you also manage models).
CF_API_TOKEN=
# Optional. Cloudflare dashboard -> AI -> AI Gateway -> create a Gateway -> copy its ID here.
# When set, requests carry a cf-aig-gateway-id header so they're routed through that Gateway,
# which absorbs Workers AI's account-level rate limit (429, code 971) with its own
# caching/rate-limit queuing/logging instead of hitting the limit directly. Left unset, requests
# go straight to api.cloudflare.com as before.
CF_AI_GATEWAY_ID=

# Required by /ingest, /reindex, and DELETE /knowledge/{id}. These mutate
# the knowledge base, so they require this shared secret in an
# `x-admin-secret` header on top of the Supabase anon/service JWT (the anon
# key alone isn't meaningful access control — it's routinely public).
# Generate with e.g. `openssl rand -hex 32`.
INGEST_ADMIN_SECRET=

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected
# automatically by `supabase start` locally and by the deployed Edge
# Function runtime. Do not set them here.
