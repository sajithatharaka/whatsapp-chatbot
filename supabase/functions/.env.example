# OpenRouter (OpenAI-compatible) API — https://openrouter.ai/api/v1/{chat/completions|embeddings}
# Used for both chat completion and embeddings. Create a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Required by /ingest, /reindex, and DELETE /knowledge/{id}. These mutate
# the knowledge base, so they require this shared secret in an
# `x-admin-secret` header on top of the Supabase anon/service JWT (the anon
# key alone isn't meaningful access control — it's routinely public).
# Generate with e.g. `openssl rand -hex 32`.
INGEST_ADMIN_SECRET=

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected
# automatically by `supabase start` locally and by the deployed Edge
# Function runtime. Do not set them here.
